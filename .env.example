# Copie para .env e ajuste o que precisar: docker compose lê esse arquivo sozinho.
# Sem .env, o compose usa exatamente estes mesmos valores como padrão.

# Portas publicadas no host.
AIRFLOW_PORT=8080
ANALYTICS_DB_PORT=5433

# Usuário admin da UI, criado pelo airflow-init.
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Base analítica (db-analytics). Mudou aqui, a connection do Airflow acompanha.
ANALYTICS_DB_NAME=ecommerce
ANALYTICS_DB_USER=ecommerce
ANALYTICS_DB_PASSWORD=ecommerce

# No Linux, use o UID do seu usuário para os arquivos em ./logs não ficarem como root:
#   echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000
